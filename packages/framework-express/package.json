{
  "name": "@aburi/framework-express",
  "version": "0.2.0",
  "description": "Aburi Express framework plugin: recognizes Express Router instances, route handlers (get/post/put/patch/delete/all), middleware (arity-3), error middleware (arity-4), and mount points (app.use('/prefix', router)) — emitting framework:express:* extKinds",
  "license": "Apache-2.0",
  "author": "kage1020",
  "homepage": "https://github.com/kage1020/Aburi/tree/main/packages/framework-express#readme",
  "bugs": {
    "url": "https://github.com/kage1020/Aburi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kage1020/Aburi.git",
    "directory": "packages/framework-express"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aburi/core": "workspace:*",
    "@aburi/types": "workspace:*"
  },
  "devDependencies": {
    "@aburi/lang-typescript": "workspace:*",
    "@types/node": "^26.0.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
