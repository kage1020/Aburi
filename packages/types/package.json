{
  "name": "@aburi/types",
  "version": "0.8.0",
  "description": "Aburi shared types: schema-generated IR / config / diff / plugin manifest, plus hand-written plugin interface signatures",
  "license": "Apache-2.0",
  "author": "kage1020",
  "homepage": "https://github.com/aburi-dev/Aburi/tree/main/packages/types#readme",
  "bugs": {
    "url": "https://github.com/aburi-dev/Aburi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aburi-dev/Aburi.git",
    "directory": "packages/types"
  },
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "codegen": "tsx scripts/codegen.ts",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aburi/schema": "workspace:*",
    "@types/node": "catalog:",
    "json-schema-to-typescript": "^16.0.0",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
