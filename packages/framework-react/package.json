{
  "name": "@aburi/framework-react",
  "version": "0.5.1",
  "description": "Aburi React framework plugin: recognizes React function components, custom hooks, contexts, forwardRef / memo wrappers, context providers, and higher-order components across .tsx / .jsx sources — emitting framework:react:* extKinds",
  "license": "Apache-2.0",
  "author": "kage1020",
  "homepage": "https://github.com/aburi-dev/Aburi/tree/main/packages/framework-react#readme",
  "bugs": {
    "url": "https://github.com/aburi-dev/Aburi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aburi-dev/Aburi.git",
    "directory": "packages/framework-react"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aburi/core": "workspace:*",
    "@aburi/types": "workspace:*"
  },
  "devDependencies": {
    "@aburi/lang-typescript": "workspace:*",
    "@aburi/test-harness": "workspace:*",
    "@aburi/test-support": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
