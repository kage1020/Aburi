{
  "name": "@aburi/plugin-registry",
  "version": "0.1.0",
  "description": "Plugin manifest validator and vocab registry: loads, validates, and tracks every @aburi/* plugin's owned extKind / effect id / framework namespaces, enforcing reservation and conflict rules",
  "license": "MIT",
  "author": "kage1020",
  "homepage": "https://github.com/kage1020/Aburi/tree/main/packages/plugin-registry#readme",
  "bugs": {
    "url": "https://github.com/kage1020/Aburi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kage1020/Aburi.git",
    "directory": "packages/plugin-registry"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aburi/types": "workspace:*",
    "ajv": "^8.20.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
