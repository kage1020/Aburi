{
  "name": "@aburi/markdown-projection",
  "version": "0.3.0",
  "description": "Aburi Markdown projection: deterministic Markdown views (workspace L0, component L1+L2, aburi diff, aburi explain) derived from aburi.ir.v1 / aburi.diff.v1 with confidence badges, dropped fold-outs, symbol-id sanitization, and CI-facing --fail-on formatter",
  "license": "Apache-2.0",
  "author": "kage1020",
  "homepage": "https://github.com/kage1020/Aburi/tree/main/packages/markdown-projection#readme",
  "bugs": {
    "url": "https://github.com/kage1020/Aburi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kage1020/Aburi.git",
    "directory": "packages/markdown-projection"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aburi/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
