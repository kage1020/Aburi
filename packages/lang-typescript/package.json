{
  "name": "@aburi/lang-typescript",
  "version": "0.3.0",
  "description": "Aburi TypeScript / TSX language plugin: tree-sitter WASM-based parseFile / extractSymbols / walkBody / normalizeAst, JSDoc-aware Signature + throws extraction, decorator + drop-hint contract, Category B / C drop rules per the drop-list design",
  "license": "MIT",
  "author": "kage1020",
  "homepage": "https://github.com/kage1020/Aburi/tree/main/packages/lang-typescript#readme",
  "bugs": {
    "url": "https://github.com/kage1020/Aburi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kage1020/Aburi.git",
    "directory": "packages/lang-typescript"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aburi/core": "workspace:*",
    "@aburi/types": "workspace:*",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "web-tree-sitter": "^0.26.10"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
