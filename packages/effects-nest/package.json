{
  "name": "@aburi/effects-nest",
  "version": "0.0.0",
  "description": "Aburi NestJS effects plugin: classifies EventEmitter2 / eventBus .emit(...) call expressions into the core event.publish effect",
  "license": "MIT",
  "author": "kage1020",
  "homepage": "https://github.com/kage1020/Aburi/tree/main/packages/effects-nest#readme",
  "bugs": {
    "url": "https://github.com/kage1020/Aburi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kage1020/Aburi.git",
    "directory": "packages/effects-nest"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aburi/types": "workspace:*"
  },
  "devDependencies": {
    "@aburi/lang-typescript": "workspace:*",
    "@types/node": "^26.0.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
