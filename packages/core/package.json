{
  "name": "@aburi/core",
  "version": "0.1.0",
  "description": "Aburi core foundation: deterministic Symbol ID generation, canonical JSON serializer (NFC + codepoint-sorted keys), 11 IR invariants checker, workspace root + JS/TS manager autodetect, and JS/TS Component autodetect (package.json#name / exports / dependency-driven framework discovery)",
  "license": "MIT",
  "author": "kage1020",
  "homepage": "https://github.com/kage1020/Aburi/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/kage1020/Aburi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kage1020/Aburi.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aburi/types": "workspace:*",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
