{
  "name": "@aburi/core",
  "version": "0.7.0",
  "description": "Aburi core foundation: deterministic Symbol ID generation, canonical JSON serializer (NFC + codepoint-sorted keys), IR integrity checker, workspace root + JS/TS manager autodetect, and JS/TS Component autodetect (package.json#name / exports / dependency-driven framework discovery)",
  "license": "Apache-2.0",
  "author": "kage1020",
  "homepage": "https://github.com/kage1020/Aburi/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/kage1020/Aburi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kage1020/Aburi.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aburi/types": "workspace:*",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17",
    "vscode-jsonrpc": "^10.0.0",
    "vscode-languageserver-protocol": "^3.18.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@aburi/schema": "workspace:*",
    "@aburi/test-support": "workspace:*",
    "@types/node": "catalog:",
    "@types/picomatch": "^4.0.3",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-language-server": "^6.0.2",
    "vitest": "catalog:"
  }
}
