{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "aburi",
  "compatibility_date": "2026-07-01",
  "preview_urls": true,
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./.vitepress/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Pages are negotiated between HTML and Markdown; hashed bundles, images and schemas never are.
    "run_worker_first": ["/*", "!/assets/*", "!/brand/*", "!/schema/*"]
  },
  "routes": [
    {
      "pattern": "aburi.dev",
      "custom_domain": true
    },
    // The former host stays attached so its links and `$schema` lines keep resolving; a redirect
    // rule in its zone answers it with a 301 to aburi.dev before the Worker runs.
    {
      "pattern": "aburi.kage1020.com",
      "custom_domain": true
    }
  ]
}
