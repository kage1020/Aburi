{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aburi.dev/schema/aburi.diff.v1.json",
  "title": "Aburi Diff Result",
  "description": "Result of aburi diff <base>..<head>. JSON projection of the matched/added/removed/moved/changed symbol pairs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "base",
    "components",
    "dependencies",
    "generator",
    "head",
    "slices",
    "summary",
    "symbols"
  ],
  "properties": {
    "$schema": {
      "const": "https://aburi.dev/schema/aburi.diff.v1.json"
    },
    "generator": { "$ref": "#/$defs/Generator" },
    "base": { "$ref": "#/$defs/IRRef" },
    "head": { "$ref": "#/$defs/IRRef" },
    "summary": { "$ref": "#/$defs/Summary" },
    "symbols": {
      "type": "array",
      "items": { "$ref": "#/$defs/SymbolChange" }
    },
    "components": { "$ref": "#/$defs/ComponentDiff" },
    "dependencies": { "$ref": "#/$defs/DependencyDiff" },
    "slices": {
      "type": "array",
      "description": "Weakly-connected components of changed Symbols over the call graph (see docs/design/slice-view.md).",
      "items": { "$ref": "#/$defs/SliceRecord" }
    }
  },

  "$defs": {
    "Generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$" }
      }
    },

    "IRRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["irSchema", "ref"],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Git ref, file path, or other identifier of the IR source."
        },
        "irSchema": {
          "type": "string",
          "minLength": 1,
          "description": "Schema id of the input IR. Must match between base and head."
        }
      }
    },

    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "changed",
        "componentsAdded",
        "componentsChanged",
        "componentsRemoved",
        "depsAdded",
        "depsRemoved",
        "droppedAdded",
        "droppedRemoved",
        "droppedToggled",
        "moved",
        "movedChanged",
        "removed",
        "unchanged"
      ],
      "properties": {
        "added":             { "type": "integer", "minimum": 0 },
        "removed":           { "type": "integer", "minimum": 0 },
        "moved":             { "type": "integer", "minimum": 0 },
        "movedChanged":      { "type": "integer", "minimum": 0 },
        "changed":           { "type": "integer", "minimum": 0 },
        "droppedToggled":    { "type": "integer", "minimum": 0 },
        "unchanged":         { "type": "integer", "minimum": 0 },
        "droppedAdded":      { "type": "integer", "minimum": 0 },
        "droppedRemoved":    { "type": "integer", "minimum": 0 },
        "componentsAdded":   { "type": "integer", "minimum": 0 },
        "componentsRemoved": { "type": "integer", "minimum": 0 },
        "componentsChanged": { "type": "integer", "minimum": 0 },
        "depsAdded":         { "type": "integer", "minimum": 0 },
        "depsRemoved":       { "type": "integer", "minimum": 0 },
        "unknown":           { "type": "integer", "minimum": 0, "description": "Symbols whose fate could not be determined because one document never analysed their file. Optional rather than required so a diff written before the counter existed stays valid; absence means \"this document predates the counter\", not \"nothing was unknown\"." }
      }
    },

    "SymbolChange": {
      "oneOf": [
        { "$ref": "#/$defs/SymbolAdded" },
        { "$ref": "#/$defs/SymbolRemoved" },
        { "$ref": "#/$defs/SymbolMoved" },
        { "$ref": "#/$defs/SymbolChanged" },
        { "$ref": "#/$defs/SymbolMovedChanged" },
        { "$ref": "#/$defs/SymbolDroppedToggled" },
        { "$ref": "#/$defs/SymbolUnknown" }
      ]
    },

    "SymbolUnknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absentFrom", "reason", "status", "symbol"],
      "description": "`symbol` is the entry as the document that does have it records it. A Symbol present in one document and absent from the other, where the absent side never analysed the file it lives in — `stats.skippedFiles[]` names that file. Not `added` or `removed`: nothing was written or deleted, the evidence is missing. Reporting it as either is the failure this status exists to prevent, because a scan that dropped a file would otherwise produce a confident report of API the author never touched.",
      "properties": {
        "status": { "const": "unknown" },
        "symbol": { "$ref": "#/$defs/Symbol" },
        "absentFrom": {
          "enum": ["base", "head"],
          "description": "Which document lacks it, which is the same document that lost the file. `head` reads as \"this may still exist\", `base` as \"this may not be new\"."
        },
        "reason": {
          "enum": [
            "over-size",
            "unreadable",
            "unroutable",
            "parse-failed",
            "parse-timeout",
            "extraction-failed"
          ],
          "description": "Why that document skipped the file, copied from its `stats.skippedFiles[]`. It decides what the reader does next: `parse-timeout` is machine-dependent and says re-run, `parse-failed` and `extraction-failed` are deterministic and say fix something."
        }
      }
    },

    "SymbolDroppedToggled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "before", "direction", "status"],
      "properties": {
        "status":    { "const": "dropped-toggled" },
        "before":    { "$ref": "#/$defs/Symbol" },
        "after":     { "$ref": "#/$defs/Symbol" },
        "direction": { "enum": ["to-dropped", "to-kept"] }
      }
    },

    "SymbolAdded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "symbol"],
      "properties": {
        "status": { "const": "added" },
        "symbol": { "$ref": "#/$defs/Symbol" }
      }
    },

    "SymbolRemoved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "symbol"],
      "properties": {
        "status": { "const": "removed" },
        "symbol": { "$ref": "#/$defs/Symbol" }
      }
    },

    "SymbolMoved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "before", "rationale", "status"],
      "properties": {
        "status":    { "const": "moved" },
        "before":    { "$ref": "#/$defs/Symbol" },
        "after":     { "$ref": "#/$defs/Symbol" },
        "rationale": { "$ref": "#/$defs/MatchRationale" }
      }
    },

    "SymbolChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "before", "delta", "status"],
      "properties": {
        "status": { "const": "changed" },
        "before": { "$ref": "#/$defs/Symbol" },
        "after":  { "$ref": "#/$defs/Symbol" },
        "delta":  { "$ref": "#/$defs/SymbolDelta" }
      }
    },

    "SymbolMovedChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "before", "delta", "rationale", "status"],
      "properties": {
        "status":    { "const": "moved+changed" },
        "before":    { "$ref": "#/$defs/Symbol" },
        "after":     { "$ref": "#/$defs/Symbol" },
        "rationale": { "$ref": "#/$defs/MatchRationale" },
        "delta":     { "$ref": "#/$defs/SymbolDelta" }
      }
    },

    "MatchRationale": {
      "enum": [
        "id-match",
        "git-rename",
        "logic-fingerprint",
        "logic-fingerprint+name-disambiguation",
        "name-signature",
        "dropped-weak-match"
      ]
    },

    "SymbolDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiChanged",
        "componentChanged",
        "logicChanged",
        "syntaxChanged",
        "visibilityChanged"
      ],
      "properties": {
        "apiChanged":         { "type": "boolean" },
        "logicChanged":       { "type": "boolean" },
        "syntaxChanged":      { "type": "boolean" },
        "componentChanged":   { "type": "boolean" },
        "visibilityChanged":  { "type": "boolean" },
        "rules":      { "$ref": "#/$defs/ArrayDelta" },
        "effects":    { "$ref": "#/$defs/ArrayDelta" },
        "calls":      { "$ref": "#/$defs/ArrayDelta" },
        "decorators": { "$ref": "#/$defs/ArrayDelta" },
        "signature":  {
          "oneOf": [
            { "$ref": "#/$defs/SignatureDelta" },
            { "type": "null" }
          ]
        }
      }
    },

    "ArrayDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "modified", "removed"],
      "properties": {
        "added":    { "type": "array" },
        "removed":  { "type": "array" },
        "modified": { "type": "array" }
      }
    },

    "SignatureDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asyncChanged",
        "generatorChanged",
        "inputs",
        "outputs",
        "throws",
        "typeParametersChanged"
      ],
      "properties": {
        "inputs":  { "$ref": "#/$defs/ArrayDelta" },
        "outputs": { "$ref": "#/$defs/ArrayDelta" },
        "throws":  { "$ref": "#/$defs/ArrayDelta" },
        "asyncChanged":           { "type": "boolean" },
        "generatorChanged":       { "type": "boolean" },
        "typeParametersChanged":  { "type": "boolean" }
      }
    },

    "ComponentDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "changed", "removed"],
      "properties": {
        "added":   { "type": "array", "items": { "$ref": "#/$defs/Component" } },
        "removed": { "type": "array", "items": { "$ref": "#/$defs/Component" } },
        "changed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["after", "before", "delta"],
            "properties": {
              "before": { "$ref": "#/$defs/Component" },
              "after":  { "$ref": "#/$defs/Component" },
              "delta": {
                "type": "object",
                "additionalProperties": false,
                "required": ["frameworksChanged", "publicApiChanged", "rootsChanged"],
                "properties": {
                  "rootsChanged":       { "type": "boolean" },
                  "publicApiChanged":   { "type": "boolean" },
                  "frameworksChanged":  { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },

    "DependencyDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed"],
      "properties": {
        "added":   { "type": "array", "items": { "$ref": "#/$defs/Dependency" } },
        "removed": { "type": "array", "items": { "$ref": "#/$defs/Dependency" } }
      }
    },

    "SliceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "members"],
      "properties": {
        "id": { "$ref": "#/$defs/SliceId" },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/SymbolId" },
          "description": "Member Symbol ids in strictly ascending lexicographic order. members[0] is the Slice anchor."
        }
      }
    },

    "SliceId": {
      "type": "string",
      "pattern": "^slice:",
      "description": "Cluster id: \"slice:\" + the anchor, which is members[0]. Derived, not independent: read members[0] for the anchor rather than stripping this prefix. The pattern checks the prefix only — the derivation itself has no JSON Schema equivalent and is enforced by the producer."
    },

    "Symbol": {
      "type": "object",
      "description": "Reference to a Symbol from aburi.ir.v1. Structurally validated as object only here; consumers should validate against aburi.ir.v1.json#/$defs/Symbol for stricter checking."
    },

    "SymbolId": {
      "type": "string",
      "minLength": 1,
      "description": "Reference to a Symbol id from aburi.ir.v1. Structurally validated as a non-empty string only here; consumers should validate against aburi.ir.v1.json#/$defs/SymbolId for stricter checking."
    },

    "Component": {
      "type": "object",
      "description": "Reference to a Component from aburi.ir.v1."
    },

    "Dependency": {
      "type": "object",
      "description": "Reference to a Dependency from aburi.ir.v1."
    }
  }
}
