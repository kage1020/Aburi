{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "codegen": {
      "inputs": ["scripts/**", "$TURBO_ROOT$/schema/**"],
      "outputs": ["src/generated/**"],
      "outputLogs": "errors-only"
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "@aburi/lang-typescript#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": ["dist/**", "wasm/**"],
      "outputLogs": "errors-only"
    },
    "test": {
      "dependsOn": ["^build", "codegen"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/schema/**", "$TURBO_ROOT$/vitest.shared.ts"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@aburi/cli#test": {
      "dependsOn": ["^build", "codegen", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/schema/**", "$TURBO_ROOT$/vitest.shared.ts"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@aburi/lang-typescript#test": {
      "dependsOn": ["^build", "@aburi/lang-typescript#build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/schema/**", "$TURBO_ROOT$/vitest.shared.ts"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "typecheck": {
      "dependsOn": ["^build", "codegen"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": [],
      "outputLogs": "errors-only"
    }
  }
}
