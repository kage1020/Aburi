{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "@aburi/lang-typescript#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": ["dist/**", "wasm/**"],
      "outputLogs": "errors-only"
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/schema/**", "$TURBO_ROOT$/vitest.shared.ts"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@aburi/github-action#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/schema/**",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/docs/**/*.md",
        "$TURBO_ROOT$/.github/workflows/*.yml"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@aburi/lang-typescript#test": {
      "dependsOn": ["^build", "@aburi/lang-typescript#build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/schema/**", "$TURBO_ROOT$/vitest.shared.ts"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": [],
      "outputLogs": "errors-only"
    }
  }
}
