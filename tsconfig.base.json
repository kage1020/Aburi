{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    "declaration": true,
    // Both map options stay off so the published packages carry only `.mjs` + `.d.mts`.
    // tsdown forces JS sourcemaps on whenever `declarationMap` is enabled, so flipping
    // either one back re-adds ~1.6 MB of `.map` files across the workspace's dist output.
    // Nothing here emits via tsc (`typecheck` runs --noEmit), so these only steer tsdown.
    "declarationMap": false,
    "sourceMap": false,
    "removeComments": false,
    "newLine": "lf",
    "preserveConstEnums": true
  }
}
