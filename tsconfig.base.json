{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    "declaration": true,
    // Enabling `declarationMap` makes rolldown-plugin-dts turn on rolldown's shared
    // output.sourcemap, which overrides `sourcemap: false` in every tsdown.config.ts and
    // brings ~1.6 MB of .map files back into dist. `dts: { sourcemap }` is the direct lever.
    "declarationMap": false,
    "removeComments": false,
    "newLine": "lf",
    "preserveConstEnums": true
  }
}
