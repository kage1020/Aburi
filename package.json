{
  "name": "aburi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Semantic IR extraction for high-level code review",
  "license": "Apache-2.0",
  "author": "kage1020",
  "homepage": "https://github.com/aburi-dev/Aburi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aburi-dev/Aburi.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "biome check .",
    "hygiene": "node scripts/check-references.mjs",
    "format": "biome check . --write",
    "changeset": "changeset",
    "release": "pnpm typecheck && pnpm test && pnpm build && changeset publish"
  },
  "devDependencies": {
    "@aburi/changelog": "workspace:*",
    "@aburi/cli": "workspace:*",
    "@aburi/lang-typescript": "workspace:*",
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "catalog:",
    "oxc-parser": "^0.158.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
